{
  "manifest_version": 3,
  "name": "ATO - Advanced Tab Organizer",
  "short_name": "ATO",
  "description": "Close duplicate tabs safely, see every window at a glance, and find any tab fast. Keyboard-first. No tracking, nothing collected.",
  "version": "3.3.0",
  "minimum_chrome_version": "157",
  "author": "Jean Lucas Lima <github.com/jeanlucaslima>",
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    },
    "default_title": "ATO - Advanced Tab Organizer"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+U",
        "mac": "Command+U"
      },
      "description": "Open ATO popup"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "tabGroups",
    "contextMenus"
  ]
}
